# =============================================================================
# Hora Azul Backend — Variables de Entorno
# =============================================================================
# Copiar este archivo como `.env` y completar con los valores reales.
# NUNCA commitear el archivo `.env` al repositorio.
# Ver NEON_SETUP.md para instrucciones de cómo obtener estos valores.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de datos — Producción (Neon PostgreSQL, rama main)
# -----------------------------------------------------------------------------
# Formato JDBC: jdbc:postgresql://[host].neon.tech/hora_azul_db?sslmode=require
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://[neon-host].neon.tech/hora_azul_db?sslmode=require
QUARKUS_DATASOURCE_USERNAME=[neon-username]
QUARKUS_DATASOURCE_PASSWORD=[neon-password]


# -----------------------------------------------------------------------------
# Base de datos — Desarrollo (Neon PostgreSQL, rama dev)
# Si no se configuran estas variables, Quarkus usará H2 en memoria por defecto.
# -----------------------------------------------------------------------------
QUARKUS_DATASOURCE_JDBC_URL_DEV=jdbc:postgresql://[neon-host-dev].neon.tech/hora_azul_db?sslmode=require
QUARKUS_DATASOURCE_USERNAME_DEV=[neon-username-dev]
QUARKUS_DATASOURCE_PASSWORD_DEV=[neon-password-dev]


# -----------------------------------------------------------------------------
# Servidor HTTP
# -----------------------------------------------------------------------------
QUARKUS_HTTP_PORT=8080


# -----------------------------------------------------------------------------
# JVM — Límites de memoria (importante para capa gratuita de Render/Koyeb)
# -----------------------------------------------------------------------------
JAVA_OPTS=-Xmx512m -Xms128m


# -----------------------------------------------------------------------------
# CORS — Orígenes permitidos en producción
# En desarrollo, se permiten todos los orígenes automáticamente.
# -----------------------------------------------------------------------------
QUARKUS_HTTP_CORS_ORIGINS=https://hora-azul.pages.dev


# -----------------------------------------------------------------------------
# Seguridad — Credenciales del administrador (Basic Auth, solo MVP)
# Cambiar estos valores por defecto antes de desplegar a producción.
# En versiones futuras reemplazar con OAuth2/OIDC.
# -----------------------------------------------------------------------------
QUARKUS_SECURITY_USERS_EMBEDDED_PLAIN_TEXT=true
HORA_AZUL_ADMIN_USERNAME=admin
HORA_AZUL_ADMIN_PASSWORD=[cambiar-antes-de-produccion]
